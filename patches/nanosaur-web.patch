+#if __EMSCRIPTEN__
+// Mouse clicks / taps on the 640x480 settings pages (drawn letterboxed with keepAspectRatio)
+static void WebHandleSettingsTap(void)
+{
+	float nx, ny;
+	if (!Web_ConsumeTap(&nx, &ny))
+		return;
+
+	extern int gWindowWidth, gWindowHeight;
+	float W = (float) gWindowWidth, H = (float) gWindowHeight;
+	if (W < 1 || H < 1)
+		return;
+	TQ3Vector2D fit = FitRectKeepAR(GAME_VIEW_WIDTH, GAME_VIEW_HEIGHT, W, H);
+	float left = (W - fit.x) * 0.5f;
+	float top  = (H - fit.y) * 0.5f;
+	int px = (int) ((nx * W - left) / fit.x * GAME_VIEW_WIDTH);
+	int py = (int) ((ny * H - top) / fit.y * GAME_VIEW_HEIGHT);
+
+	if (gSettingsState == kSettingsState_MainPage)
+	{
+		int row = (py - 75) / 16;
+		if (py < 75 || row < 0 || row >= numSettingEntries || !gSettingEntries[row].label)
+			return;
+		selectedEntry = row;
+		Cycle(&gSettingEntries[row], 1);
+		PlayEffect(EFFECT_BLASTER);
+		needFullRender = true;
+	}
+	else if (gSettingsState == kSettingsState_ControlsPage)
+	{
+		int row = (py - 75) / 16;
+		if (py < 75) return;
+		if (row >= 0 && row < NUM_REMAPPABLE_NEEDS)
+		{
+			controlsHighlightedRow = row;
+			controlsHighlightedColumn = (px >= kColumnX[2]) ? 1 : 0;
+			gSettingsState = kSettingsState_ControlsPage_AwaitingPress;
+			needFullRender = true;
+		}
+		else if (row == NUM_REMAPPABLE_NEEDS + 1)
+		{
+			controlsHighlightedRow = kKeybindingRow_Reset;
+			SDL_memcpy(gGamePrefs.keys, kDefaultKeyBindings, sizeof(kDefaultKeyBindings));
+			Web_ApplyPlatformDefaultKeys();
+			PlayEffect_Parms(EFFECT_CRYSTAL, FULL_CHANNEL_VOLUME/2, kMiddleC-6);
+			needFullRender = true;
+		}
+		else if (row == NUM_REMAPPABLE_NEEDS + 2)
+		{
+			Callback_Done();
+		}
+	}
+}
+#endif
