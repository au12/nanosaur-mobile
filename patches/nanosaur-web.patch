+
+EMSCRIPTEN_KEEPALIVE void Web_SetVirtualNeed(int needID, int state)
+{
+	if (needID < 0 || needID >= NUM_CONTROL_NEEDS)
+		return;
+	switch (state)
+	{
+		case 0:	gVirtualNeedHeld[needID] = 0; break;
+		case 1:	gVirtualNeedHeld[needID] = 1; break;
+		default: gVirtualNeedPulse[needID] = 2; break;		// press for 2 input polls
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_PulseScancode(int scancode)
+{
+	if (scancode > 0 && scancode < SDL_SCANCODE_COUNT)
+		gVirtualScancodePulse[scancode] = 2;
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_SetStick(float x, float y, int active)
+{
+	gStickX = x;
+	gStickY = y;
+	gStickActive = active != 0;
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_SetTouchMode(int on)
+{
+	gTouchMode = on != 0;
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_TapAt(float nx, float ny)
+{
+	switch (gWebScreen)
+	{
+		case kWebScreen_Game:
+			// Tap anywhere = jump, unless an egg is right there to pick up
+			if (gPlayerObj && !(gPlayerObj->StatusBits & STATUS_BIT_ISCARRYING) && Web_IsPickupNearby())
+				Web_SetVirtualNeed(kNeed_PickUp, 2);
+			else
+				WebMove_RequestJump();
+			break;
+
+		case kWebScreen_MainMenu:
+		case kWebScreen_Paused:
+		case kWebScreen_Settings:
+		case kWebScreen_Controls:
+			gTapX = nx;
+			gTapY = ny;
+			gTapPending = true;
+			break;
+
+		case kWebScreen_Logo:
+		case kWebScreen_Charity:
+		case kWebScreen_Title:
+		case kWebScreen_Help:
+		case kWebScreen_HighScores:
+		case kWebScreen_Movie:
+			Web_SetVirtualNeed(kNeed_UIConfirm, 2);
+			break;
+
+		default:
+			break;
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_Swipe(int dir)
+{
+	if (gWebScreen == kWebScreen_MainMenu)
+		gSwipePending = dir;
+	else if (gWebScreen == kWebScreen_Paused)
+		Web_SetVirtualNeed(dir < 0 ? kNeed_UIUp : kNeed_UIDown, 2);
+}
