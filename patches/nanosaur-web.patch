+
+// Command (GUI) can't be a game key in a browser: on macOS, while Command is held the
+// browser stops delivering key-up events for every other key, so arrow keys released
+// mid-jump stay "held" and Nano spins. Mac players get Option to jump and C to pick up.
+#define WEB_MAC_PICKUP_KEY	SDL_SCANCODE_C
+
+static bool IsGuiScancode(int sc)
+{
+	return sc == SDL_SCANCODE_LGUI || sc == SDL_SCANCODE_RGUI;
+}
+
+static void UnbindScancodeEverywhere(int sc)
+{
+	for (int i = 0; i < NUM_REMAPPABLE_NEEDS; i++)
+		for (int j = 0; j < KEYBINDING_MAX_KEYS; j++)
+			if (gGamePrefs.keys[i].key[j] == sc)
+				gGamePrefs.keys[i].key[j] = 0;
+}
+
+void Web_ApplyPlatformDefaultKeys(void)
+{
+	// The compiled-in defaults are the PC layout (Alt = jump, Ctrl = pick up). On a Mac,
+	// Ctrl+arrow keys switch Spaces / open Mission Control, so pick-up moves to C.
+	if (!js_is_mac())
+		return;
+	gGamePrefs.keys[kNeed_Jump].key[0]		= SDL_SCANCODE_LALT;
+	gGamePrefs.keys[kNeed_Jump].key[1]		= SDL_SCANCODE_RALT;
+	gGamePrefs.keys[kNeed_PickUp].key[0]	= WEB_MAC_PICKUP_KEY;
+	gGamePrefs.keys[kNeed_PickUp].key[1]	= 0;
+}
+
+void Web_SanitizeKeyBindings(void)
+{
+	bool hadGui = false;
+	for (int i = 0; i < NUM_REMAPPABLE_NEEDS; i++)
+	{
+		for (int j = 0; j < KEYBINDING_MAX_KEYS; j++)
+		{
+			if (IsGuiScancode(gGamePrefs.keys[i].key[j]))
+			{
+				gGamePrefs.keys[i].key[j] = 0;
+				hadGui = true;
+			}
+		}
+	}
+
+	if (!hadGui)
+		return;
+
+	// Older web builds put Jump on Command and Pick Up on Option. Re-home whatever was left empty.
+	KeyBinding* jump = &gGamePrefs.keys[kNeed_Jump];
+	KeyBinding* pick = &gGamePrefs.keys[kNeed_PickUp];
+	if (!jump->key[0] && !jump->key[1])
+	{
+		UnbindScancodeEverywhere(SDL_SCANCODE_LALT);
+		UnbindScancodeEverywhere(SDL_SCANCODE_RALT);
+		jump->key[0] = SDL_SCANCODE_LALT;
+		jump->key[1] = SDL_SCANCODE_RALT;
+	}
+	if (!pick->key[0] && !pick->key[1])
+	{
+		UnbindScancodeEverywhere(WEB_MAC_PICKUP_KEY);
+		pick->key[0] = WEB_MAC_PICKUP_KEY;
+	}
+	js_event_i("keysmigrated", 0, 0);
+}
+
+bool Web_ConsumeSettingsDirty(void)
