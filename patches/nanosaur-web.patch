+
+int Web_PickMainMenuIcon(float nx, float ny, int numIcons)
+{
+	int best = -1;
+	float bestDist = 1e9f;
+	float aspect = gWindowHeight > 0 ? (float) gWindowWidth / gWindowHeight : 1.333f;
+
+	for (int i = 0; i < numIcons; i++)
+	{
+		ObjNode* icon = gMainMenuIcons[i];
+		if (!icon)
+			continue;
+		float ix, iy;
+		if (!Web_WorldToWindow(icon->Coord.x, icon->Coord.y + 30.0f, icon->Coord.z, &ix, &iy))
+			continue;
+		float dx = (ix - nx) * aspect;
+		float dy = (iy - ny);
+		float d = sqrtf(dx*dx + dy*dy);
+		if (d < bestDist)
+		{
+			bestDist = d;
+			best = i;
+		}
+	}
+
+	if (bestDist > 0.30f)		// generous radius (in screen-height units)
+		return -1;
+	return best;
+}
