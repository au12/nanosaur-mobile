+
+bool Web_IsPickupNearby(void)
+{
+	if (!gPlayerObj || !gFirstNodePtr || !gPlayerObj->Skeleton)
+		return false;
+
+	if (gPlayerObj->StatusBits & STATUS_BIT_ISCARRYING)
+		return false;
+
+	static const TQ3Point3D inPoint = {0, 0, -30};
+	TQ3Point3D mouth;
+	FindCoordOnJoint(gPlayerObj, MYGUY_LIMB_HEAD, &inPoint, &mouth);
+
+	ObjNode* node = gFirstNodePtr;
+	while (node)
+	{
+		if (node->Slot >= SLOT_OF_DUMB)
+			break;
+
+		if ((node->CType & CTYPE_PICKUP)
+			&& !(node->StatusBits & STATUS_BIT_NOCOLLISION)
+			&& node->CBits)
+		{
+			float d = CalcQuickDistance(mouth.x, mouth.z, node->Coord.x, node->Coord.z);
+			if (d <= node->PickUpCollisionRadius + 40.0f
+				&& fabsf(node->Coord.y - gPlayerObj->Coord.y) < 250.0f)
+			{
+				return true;
+			}
+		}
+		node = node->NextNode;
+	}
+	return false;
+}
+
+void Web_UpdateGameplayHUD(void)
+{
+	static int last[10];
+	static bool primed = false;
+
+	int cur[10];
+	cur[0] = (int) gTimeRemaining;
+	cur[1] = (int) gScore;
+	cur[2] = (int) (SDL_clamp(gMyHealth, 0.0f, 1.0f) * 1000.0f);
+	cur[3] = gNumLives;
+	cur[4] = gCurrentAttackMode;
+	cur[5] = gWeaponInventory[gCurrentAttackMode];
+	cur[6] = INFOBAR_FRAMENUM_FUELGAUGE + (int) (MAX_FUEL_CAPACITY - gFuel);
+
+	// Eggs recovered per species, 4 bits each (the game needs one of each of the 5 species,
+	// but every extra egg beamed up still counts for points, so the HUD shows the tally)
+	int eggs = 0;
+	for (int i = 0; i < NUM_EGG_SPECIES; i++)
+		eggs |= SDL_min((int) gRecoveredEggs[i], 15) << (4 * i);
+	cur[7] = eggs;
+
+	int flags = 0;
+	if (gPlayerObj)
+	{
+		if (gPlayerObj->StatusBits & STATUS_BIT_ISCARRYING)	flags |= 1 << 0;
+		if (Web_IsPickupNearby())							flags |= 1 << 1;
+		if (gPlayerObj->JetThrust)							flags |= 1 << 2;
+		if (gPlayerObj->StatusBits & STATUS_BIT_ONGROUND)	flags |= 1 << 3;
+	}
+	if (gFuel > 0.0f)				flags |= 1 << 4;
+	if (gPlayerGotKilledFlag)		flags |= 1 << 5;
+	if (gTimeRemaining < 30.0f)		flags |= 1 << 6;
+	if (gGamePrefs.hudStyle == kWebHUD_Classic)	flags |= 1 << 7;
+	if (gGamePaused)				flags |= 1 << 8;
+	cur[8] = flags;
+
+	int weaponMask = 0;
+	for (int i = 0; i < NUM_ATTACK_MODES; i++)
+		if (gPossibleAttackModes[i])
+			weaponMask |= 1 << i;
+	cur[9] = weaponMask;
+
+	if (!primed || SDL_memcmp(cur, last, sizeof(cur)) != 0)
+	{
+		SDL_memcpy(last, cur, sizeof(cur));
+		primed = true;
+		js_hud(cur[0], cur[1], cur[2], cur[3], cur[4], cur[5], cur[6], cur[7], cur[8], cur[9]);
+	}
+}
