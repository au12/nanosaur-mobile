+		bool left = GetNeedState(kNeed_TurnLeft), right = GetNeedState(kNeed_TurnRight);
+		if (left && right)
+			bits |= (lastTurn > 0) ? KEYCONTROL_ROTRIGHT : KEYCONTROL_ROTLEFT;
+		else if (left)
+			bits |= KEYCONTROL_ROTLEFT;
+		else if (right)
+			bits |= KEYCONTROL_ROTRIGHT;
+
+		bool fwd = GetNeedState(kNeed_Forward), back = GetNeedState(kNeed_Backward);
+		if (fwd && back)
+			bits |= (lastMove < 0) ? KEYCONTROL_BACKWARD : KEYCONTROL_FORWARD;
+		else if (fwd)
+			bits |= KEYCONTROL_FORWARD;
+		else if (back)
+			bits |= KEYCONTROL_BACKWARD;
