+/****************************/
+/*    DRAW                  */
+/****************************/
+
+static void UploadUniforms(Program* p, int variant)
+{
+	if (p->seenMatrixSerial != S.matrixSerial)
+	{
+		const Mat4* mv = &S.mvStack[S.mvTop];
+		glUniformMatrix4fv(p->uMV, 1, GL_FALSE, mv->m);
+		glUniformMatrix4fv(p->uProj, 1, GL_FALSE, S.projStack[S.projTop].m);
+		if ((variant & kFeatLighting) && p->uNormalMat >= 0)
+		{
+			float nm[9];
+			CalcNormalMatrix(mv, nm);
+			glUniformMatrix3fv(p->uNormalMat, 1, GL_FALSE, nm);
+		}
+		p->seenMatrixSerial = S.matrixSerial;
+	}
+
+	if ((variant & kFeatLighting) && p->seenLightSerial != S.lightSerial)
+	{
+		float dir[MAX_LIGHTS*3], amb[MAX_LIGHTS*3], dif[MAX_LIGHTS*3];
+		int n = 0;
+		for (int i = 0; i < 8 && n < MAX_LIGHTS; i++)
+		{
+			const Light* l = &S.lights[i];
+			if (!l->enabled)
+				continue;
+			float x = l->eyeDir[0], y = l->eyeDir[1], z = l->eyeDir[2];
+			float len = sqrtf(x*x + y*y + z*z);
+			if (len > 1e-6f) { x /= len; y /= len; z /= len; }
+			dir[n*3+0] = x; dir[n*3+1] = y; dir[n*3+2] = z;
+			amb[n*3+0] = l->ambient[0]; amb[n*3+1] = l->ambient[1]; amb[n*3+2] = l->ambient[2];
+			dif[n*3+0] = l->diffuse[0]; dif[n*3+1] = l->diffuse[1]; dif[n*3+2] = l->diffuse[2];
+			n++;
+		}
+		glUniform1i(p->uNumLights, n);
+		if (n > 0)
+		{
+			glUniform3fv(p->uLightDir, n, dir);
+			glUniform3fv(p->uLightAmb, n, amb);
+			glUniform3fv(p->uLightDiff, n, dif);
+		}
+		glUniform3fv(p->uSceneAmbient, 1, S.sceneAmbient);
+		glUniform4fv(p->uMatAmbient, 1, S.matAmbient);
+		glUniform4fv(p->uMatDiffuse, 1, S.matDiffuse);
+		glUniform1i(p->uColorMaterial, S.colorMaterial ? 1 : 0);
+		p->seenLightSerial = S.lightSerial;
+	}
+
+	if ((variant & kFeatFog) && p->seenFogSerial != S.fogSerial)
+	{
+		float mode = (S.fogMode == LGL_EXP) ? 1.0f : (S.fogMode == LGL_EXP2) ? 2.0f : 0.0f;
+		glUniform4f(p->uFogParams, S.fogStart, S.fogEnd, S.fogDensity, mode);
+		glUniform3fv(p->uFogColor, 1, S.fogColor);
+		p->seenFogSerial = S.fogSerial;
+	}
+
+	if ((variant & kFeatAlphaTest) && p->seenMiscSerial != S.miscSerial)
+	{
+		// The game only uses GL_GREATER; approximate the others conservatively.
+		float ref = S.alphaRef;
+		if (S.alphaFunc == GL_GEQUAL)
+			ref -= 1.0f / 512.0f;
+		glUniform1f(p->uAlphaRef, ref);
+		p->seenMiscSerial = S.miscSerial;
+	}
+}
+
+static GLsizeiptr RingAlloc(GLenum target, GLuint buffer, GLsizeiptr* off, GLsizeiptr* cap, GLsizeiptr bytes, GLsizeiptr align)
+{
+	GLsizeiptr o = (*off + (align - 1)) & ~(align - 1);
+	if (bytes > *cap)
+	{
+		// Grow
+		while (*cap < bytes) *cap *= 2;
+		glBindBuffer(target, buffer);
+		glBufferData(target, *cap, NULL, GL_STREAM_DRAW);
+		o = 0;
+	}
+	else if (o + bytes > *cap)
+	{
+		// Orphan & restart
+		glBindBuffer(target, buffer);
+		glBufferData(target, *cap, NULL, GL_STREAM_DRAW);
+		o = 0;
+	}
+	*off = o + bytes;
+	return o;
+}
+
+void WebGL_DrawElements(GLenum mode, GLsizei count, GLenum type, const GLvoid* indices)
+{
+	EnsureInit();
+
+	if (count <= 0 || !indices || !S.arrays[kAttribPos].enabled || !S.arrays[kAttribPos].ptr)
+		return;
+
+	// Find vertex range
+	uint32_t maxIndex = 0;
+	int indexBytes;
+	switch (type)
+	{
+		case GL_UNSIGNED_BYTE:
+		{
+			const uint8_t* ix = (const uint8_t*) indices;
+			for (int i = 0; i < count; i++) if (ix[i] > maxIndex) maxIndex = ix[i];
+			indexBytes = 1;
+			break;
+		}
+		case GL_UNSIGNED_SHORT:
+		{
+			const uint16_t* ix = (const uint16_t*) indices;
+			for (int i = 0; i < count; i++) if (ix[i] > maxIndex) maxIndex = ix[i];
+			indexBytes = 2;
+			break;
+		}
+		case GL_UNSIGNED_INT:
+		default:
+		{
+			const uint32_t* ix = (const uint32_t*) indices;
+			for (int i = 0; i < count; i++) if (ix[i] > maxIndex) maxIndex = ix[i];
+			indexBytes = 4;
+			type = GL_UNSIGNED_INT;
+			break;
+		}
+	}
+	const uint32_t numVerts = maxIndex + 1;
+
+	// Determine which attributes are live
+	const bool useNormal	= S.lighting && S.arrays[kAttribNormal].enabled && S.arrays[kAttribNormal].ptr;
+	const bool useColor		= S.arrays[kAttribColor].enabled && S.arrays[kAttribColor].ptr;
+	const bool useUV		= S.texture2D && S.arrays[kAttribUV].enabled && S.arrays[kAttribUV].ptr;
+
+	// Pack attributes into scratch
+	size_t attrBytes[4] = {0,0,0,0};
+	size_t attrOffs[4] = {0,0,0,0};
+	bool live[4] = { true, useNormal, useColor, useUV };
+	size_t total = 0;
+	for (int a = 0; a < 4; a++)
+	{
+		if (!live[a]) continue;
+		const ClientArray* arr = &S.arrays[a];
+		size_t elem = (size_t) arr->size * ComponentBytes(arr->type);
+		attrBytes[a] = elem * numVerts;
+		total = (total + 3) & ~(size_t)3;
+		attrOffs[a] = total;
+		total += attrBytes[a];
+	}
+
+	uint8_t* buf = (uint8_t*) Scratch(total);
+	for (int a = 0; a < 4; a++)
+	{
+		if (!live[a]) continue;
+		const ClientArray* arr = &S.arrays[a];
+		size_t elem = (size_t) arr->size * ComponentBytes(arr->type);
+		size_t stride = arr->stride ? (size_t) arr->stride : elem;
+		if (stride == elem)
+		{
+			memcpy(buf + attrOffs[a], arr->ptr, attrBytes[a]);
+		}
+		else
+		{
+			const uint8_t* src = (const uint8_t*) arr->ptr;
+			uint8_t* dst = buf + attrOffs[a];
+			for (uint32_t v = 0; v < numVerts; v++)
+				memcpy(dst + v*elem, src + v*stride, elem);
+		}
+	}
+
+	// Upload vertex data
+	glBindVertexArray(S.vao);
+	GLsizeiptr vOff = RingAlloc(GL_ARRAY_BUFFER, S.vbo, &S.vboOff, &S.vboCap, (GLsizeiptr) total, 16);
+	glBindBuffer(GL_ARRAY_BUFFER, S.vbo);
+	glBufferSubData(GL_ARRAY_BUFFER, vOff, (GLsizeiptr) total, buf);
+
+	for (int a = 0; a < 4; a++)
+	{
+		if (live[a])
+		{
+			const ClientArray* arr = &S.arrays[a];
+			GLboolean norm = (arr->type == GL_UNSIGNED_BYTE && a == kAttribColor) ? GL_TRUE : GL_FALSE;
+			glEnableVertexAttribArray(a);
+			glVertexAttribPointer(a, arr->size, arr->type, norm, 0, (const void*)(uintptr_t)(vOff + attrOffs[a]));
+		}
+		else
+		{
+			glDisableVertexAttribArray(a);
+		}
+	}
+	if (!useNormal)	glVertexAttrib4f(kAttribNormal, 0, 0, 1, 0);
+	if (!useColor)	glVertexAttrib4f(kAttribColor, S.color[0], S.color[1], S.color[2], S.color[3]);
+	if (!useUV)		glVertexAttrib4f(kAttribUV, 0, 0, 0, 1);
+
+	// Upload indices
+	GLsizeiptr iBytes = (GLsizeiptr) count * indexBytes;
+	GLsizeiptr iOff = RingAlloc(GL_ELEMENT_ARRAY_BUFFER, S.ibo, &S.iboOff, &S.iboCap, iBytes, 4);
+	glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, S.ibo);
+	glBufferSubData(GL_ELEMENT_ARRAY_BUFFER, iOff, iBytes, indices);
+
+	// Program
+	int variant = 0;
+	if (S.lighting)						variant |= kFeatLighting;
+	if (useUV)							variant |= kFeatTexture;
+	if (S.fog)							variant |= kFeatFog;
+	if (S.alphaTest && S.alphaFunc != GL_ALWAYS)	variant |= kFeatAlphaTest;
+
+	Program* p = GetProgram(variant);
+	if (S.currentProgram != variant)
+	{
+		glUseProgram(p->program);
+		S.currentProgram = variant;
+	}
+	UploadUniforms(p, variant);
+
+	glDrawElements(mode, count, type, (const void*)(uintptr_t) iOff);
+}
+
+/****************************/
+/*    TEXTURES              */
+/****************************/
+
+static void SetTexKind(GLuint name, uint8_t kind)
+{
+	if ((int) name >= S.texKindsCap)
+	{
+		int newCap = S.texKindsCap ? S.texKindsCap : 256;
+		while (newCap <= (int) name) newCap *= 2;
+		S.texKinds = realloc(S.texKinds, newCap);
+		memset(S.texKinds + S.texKindsCap, 0, newCap - S.texKindsCap);
+		S.texKindsCap = newCap;
+	}
+	S.texKinds[name] = kind;
+}
+
+static uint8_t GetTexKind(GLuint name)
+{
+	if ((int) name < S.texKindsCap)
+		return S.texKinds[name];
+	return kTexKind_None;
+}
+
+void WebGL_BindTexture(GLenum target, GLuint texture)
+{
+	EnsureInit();
+	S.boundTexture = texture;
+	glBindTexture(target, texture);
+}
+
+void WebGL_DeleteTextures(GLsizei n, const GLuint* textures)
+{
+	for (int i = 0; i < n; i++)
+	{
+		if (textures[i] == S.boundTexture)
+			S.boundTexture = 0;
+		SetTexKind(textures[i], kTexKind_None);
+	}
+	glDeleteTextures(n, textures);
+}
+
+void WebGL_TexParameteri(GLenum target, GLenum pname, GLint param)
+{
+	if (param == LGL_CLAMP)
+		param = GL_CLAMP_TO_EDGE;
+	glTexParameteri(target, pname, param);
+}
+
+void WebGL_PixelStorei(GLenum pname, GLint param)
+{
+	EnsureInit();
+	if (pname == LGL_UNPACK_ROW_LENGTH)
+	{
+		S.unpackRowLength = param;
+		return;
+	}
+	if (pname == GL_UNPACK_ALIGNMENT)
+		return;			// we always repack tightly
+	glPixelStorei(pname, param);
+}
+
+// Converts a rectangle of game pixels to the texture's storage format.
+// Returns pointer to a tightly-packed buffer (or NULL if the format is unsupported).
+static const void* ConvertPixels(
+		const void* pixels, int width, int height, int rowLength,
+		GLenum format, GLenum type, bool forceOpaque, uint8_t destKind,
+		GLenum* outFormat, GLenum* outType)
+{
+	if (!pixels)
+		return NULL;
+
+	const int srcPitchPx = rowLength > 0 ? rowLength : width;
+
+	if (type == LGL_UNSIGNED_SHORT_1_5_5_5_REV)
+	{
+		// Source: A1 R5 G5 B5 (bit 15 = alpha)
+		const uint16_t* src = (const uint16_t*) pixels;
+		if (destKind == kTexKind_RGB5A1)
+		{
+			uint16_t* dst = (uint16_t*) PixScratch((size_t) width * height * 2);
+			for (int y = 0; y < height; y++)
+			{
+				const uint16_t* s = src + (size_t) y * srcPitchPx;
+				uint16_t* d = dst + (size_t) y * width;
+				for (int x = 0; x < width; x++)
+				{
+					uint16_t v = s[x];
+					uint16_t a = forceOpaque ? 1 : (v >> 15);
+					d[x] = (uint16_t)(((v & 0x7FFF) << 1) | a);		// -> R5 G5 B5 A1
+				}
+			}
+			*outFormat = GL_RGBA;
+			*outType = GL_UNSIGNED_SHORT_5_5_5_1;
+			return dst;
+		}
+		else
+		{
+			uint8_t* dst = (uint8_t*) PixScratch((size_t) width * height * 4);
+			for (int y = 0; y < height; y++)
+			{
+				const uint16_t* s = src + (size_t) y * srcPitchPx;
+				uint8_t* d = dst + (size_t) y * width * 4;
+				for (int x = 0; x < width; x++)
+				{
+					uint16_t v = s[x];
+					uint8_t r = (v >> 10) & 0x1F, g = (v >> 5) & 0x1F, b = v & 0x1F;
+					d[x*4+0] = (uint8_t)((r << 3) | (r >> 2));
+					d[x*4+1] = (uint8_t)((g << 3) | (g >> 2));
+					d[x*4+2] = (uint8_t)((b << 3) | (b >> 2));
+					d[x*4+3] = (forceOpaque || (v & 0x8000)) ? 255 : 0;
+				}
+			}
+			*outFormat = GL_RGBA;
+			*outType = GL_UNSIGNED_BYTE;
+			return dst;
+		}
+	}
+	else if (format == LGL_BGRA && (type == LGL_UNSIGNED_INT_8_8_8_8 || type == LGL_UNSIGNED_INT_8_8_8_8_REV || type == GL_UNSIGNED_BYTE))
+	{
+		// On little-endian: 8_8_8_8 BGRA == bytes A,R,G,B in memory (classic Mac ARGB).
+		//                   8_8_8_8_REV BGRA / UNSIGNED_BYTE BGRA == bytes B,G,R,A.
+		const uint8_t* src = (const uint8_t*) pixels;
+		uint8_t* dst = (uint8_t*) PixScratch((size_t) width * height * 4);
+		const bool argb = (type == LGL_UNSIGNED_INT_8_8_8_8);
+		for (int y = 0; y < height; y++)
+		{
+			const uint8_t* s = src + (size_t) y * srcPitchPx * 4;
+			uint8_t* d = dst + (size_t) y * width * 4;
+			if (argb)
+			{
+				for (int x = 0; x < width; x++)
+				{
+					d[0] = s[1]; d[1] = s[2]; d[2] = s[3]; d[3] = forceOpaque ? 255 : s[0];
+					s += 4; d += 4;
+				}
+			}
+			else
+			{
+				for (int x = 0; x < width; x++)
+				{
+					d[0] = s[2]; d[1] = s[1]; d[2] = s[0]; d[3] = forceOpaque ? 255 : s[3];
+					s += 4; d += 4;
+				}
+			}
+		}
+		*outFormat = GL_RGBA;
+		*outType = GL_UNSIGNED_BYTE;
+		return dst;
+	}
+	else if ((format == GL_RGBA || format == GL_RGB) && type == GL_UNSIGNED_BYTE)
+	{
+		const int bpp = (format == GL_RGBA) ? 4 : 3;
+		const uint8_t* src = (const uint8_t*) pixels;
+		uint8_t* dst = (uint8_t*) PixScratch((size_t) width * height * 4);
+		for (int y = 0; y < height; y++)
+		{
+			const uint8_t* s = src + (size_t) y * srcPitchPx * bpp;
+			uint8_t* d = dst + (size_t) y * width * 4;
+			for (int x = 0; x < width; x++)
+			{
+				d[0] = s[0]; d[1] = s[1]; d[2] = s[2];
+				d[3] = (bpp == 4 && !forceOpaque) ? s[3] : 255;
+				s += bpp; d += 4;
+			}
+		}
+		*outFormat = GL_RGBA;
+		*outType = GL_UNSIGNED_BYTE;
+		return dst;
+	}
+
+	printf("[WebGL_FFP] unsupported pixel format 0x%x / type 0x%x\n", format, type);
+	return NULL;
+}
+
+void WebGL_TexImage2D(GLenum target, GLint level, GLint internalFormat, GLsizei width, GLsizei height,
+					  GLint border, GLenum format, GLenum type, const GLvoid* pixels)
+{
+	EnsureInit();
+	(void) border;
+
+	const bool forceOpaque = (internalFormat == GL_RGB || internalFormat == 3);
+	const uint8_t kind = (type == LGL_UNSIGNED_SHORT_1_5_5_5_REV) ? kTexKind_RGB5A1 : kTexKind_RGBA8;
+	const GLenum sizedFormat = (kind == kTexKind_RGB5A1) ? GL_RGB5_A1 : GL_RGBA8;
+
+	GLenum upFormat = GL_RGBA, upType = (kind == kTexKind_RGB5A1) ? GL_UNSIGNED_SHORT_5_5_5_1 : GL_UNSIGNED_BYTE;
+	const void* data = NULL;
+	if (pixels)
+	{
+		data = ConvertPixels(pixels, width, height, S.unpackRowLength, format, type, forceOpaque, kind, &upFormat, &upType);
+	}
+
+	glTexImage2D(target, level, sizedFormat, width, height, 0, upFormat, upType, data);
+	SetTexKind(S.boundTexture, (uint8_t)(kind | (forceOpaque ? kTexFlag_Opaque : 0)));
+}
+
+void WebGL_TexSubImage2D(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLsizei width,
+						 GLsizei height, GLenum format, GLenum type, const GLvoid* pixels)
+{
+	EnsureInit();
+	if (width <= 0 || height <= 0)
+		return;
+
+	uint8_t kindBits = GetTexKind(S.boundTexture);
+	const bool forceOpaque = (kindBits & kTexFlag_Opaque) != 0;
+	uint8_t kind = kindBits & ~kTexFlag_Opaque;
+	if (kind == kTexKind_None)
+		kind = kTexKind_RGBA8;
+
+	// If the source is 1555 but the texture is RGBA8 (or vice versa), ConvertPixels picks the right path
+	uint8_t convKind = (type == LGL_UNSIGNED_SHORT_1_5_5_5_REV) ? kind : kTexKind_RGBA8;
+	if (kind == kTexKind_RGB5A1 && type != LGL_UNSIGNED_SHORT_1_5_5_5_REV)
+	{
+		printf("[WebGL_FFP] TexSubImage format mismatch on texture %u\n", S.boundTexture);
+		return;
+	}
+
+	GLenum upFormat, upType;
+	const void* data = ConvertPixels(pixels, width, height, S.unpackRowLength, format, type,
+									 forceOpaque, convKind, &upFormat, &upType);
+	if (!data)
+		return;
+
+	glTexSubImage2D(target, level, xoffset, yoffset, width, height, upFormat, upType, data);
+}
+
+/****************************/
+/*    RESET (CONTEXT LOSS)  */
+/****************************/
+
+void WebGL_FFP_ResetGPUObjects(void)
+{
+	memset(S.programs, 0, sizeof(S.programs));
+	S.currentProgram = -1;
+	S.initialized = false;
+}
diff --git a/src/Web/WebTouchMove.c b/src/Web/WebTouchMove.c
new file mode 100644
index 0000000..c96ef6d
--- /dev/null
+++ b/src/Web/WebTouchMove.c
@@ -0,0 +1,335 @@
+// WEBTOUCHMOVE.C
+// Touch locomotion for the web port.
+//
+// The on-screen stick gives a direction relative to the camera. When the finger starts
+// pushing, the camera's heading is locked as the reference (using the camera's *target*
+// heading behind Nano, not its lagging position, so pushing straight up never veers).
+// Nano turns smoothly toward the pushed direction and runs that way for as long as the
+// finger is held; swinging the finger round turns him without lifting it.
+//
+// Unlike the keyboard's tank controls, Nano's velocity follows his facing (no skating
+// sideways after a turn), speed follows how far the stick is pushed, and lifting the
+// finger brings him to a stop almost immediately.
+//
+// Taps are jumps: a jump request is buffered briefly so a tap in mid-air fires the double
+// jump as soon as the game allows it, instead of being lost if it came a little early.
+
+#include "game.h"
+
+/****************************/
+/*    CONSTANTS             */
+/****************************/
+
+#define STICK_DEADZONE			0.14f
+#define STICK_FULL				0.85f		// stick deflection that already counts as full speed
+#define RELOCK_DELAY			0.12f		// seconds in the deadzone before the reference is released
+
+#define GROUND_TURN_GAIN		12.0f		// rad/s of turn per rad of heading error
+#define GROUND_TURN_MAX			8.0f		// rad/s
+#define AIR_TURN_GAIN			8.0f
+#define AIR_TURN_MAX			4.5f
+#define JET_TURN_MAX			3.0f
+
+#define GROUND_ACCEL			2600.0f		// speeding up toward the target speed
+#define GROUND_DECEL			3200.0f		// slowing down toward the target speed
+#define GROUND_GRIP				14.0f		// how fast sideways sliding is cancelled (1/s)
+#define AIR_ACCEL				900.0f
+#define AIR_GRIP				2.5f
+
+#define RELEASE_BRAKE			18.0f		// 1/s exponential stop when the finger lifts
+#define RELEASE_STOP_SPEED		25.0f
+
+#define TURN_IN_PLACE_SPEED		120.0f		// below this speed, big heading changes use the turn anims
+#define TURN_IN_PLACE_ANGLE		0.45f
+
+#define JUMP_BUFFER_GROUND		0.20f
+#define JUMP_BUFFER_AIR			0.55f		// waiting for the double-jump window to open
+#define JUMP_BUFFER_LANDING		0.12f		// too late for a double jump: jump again only if about to land
+#define DOUBLE_JUMP_MIN_VY		(-300.0f)	// matches DoPlayerControl's double-jump window
+
+/****************************/
+/*    STATE                 */
+/****************************/
+
+static bool		gSteering = false;			// finger outside the deadzone
+static bool		gLocked = false;			// reference heading locked for this push
+static float	gRefHeading = 0;
+static float	gTargetHeading = 0;
+static float	gThrottle = 0;				// 0..1
+static float	gDeadzoneTime = 0;
+static float	gJumpBuffer = 0;
+
+/****************************/
+/*    HELPERS               */
+/****************************/
+
+static float WrapAngle(float a)
+{
+	a = fmodf(a + PI, PI2);
+	if (a < 0)
+		a += PI2;
+	return a - PI;
+}
+
+static float Approach(float value, float target, float upRate, float downRate, float dt)
+{
+	if (value < target)
+		return SDL_min(target, value + upRate * dt);
+	else
+		return SDL_max(target, value - downRate * dt);
+}
+
+// Heading the chase camera is heading toward (no lag): straight behind Nano, plus any swivel
+static float GetIdealCameraHeading(void)
+{
+	float h = gPlayerObj->Rot.y;
+	if (gCameraMode == CAMERA_MODE_MANUAL)
+		h += gCameraViewYAngle;
+	return h;
+}
+
+static bool IsGroundLocomotionAnim(int anim)
+{
+	return anim == PLAYER_ANIM_STAND
+		|| anim == PLAYER_ANIM_WALK
+		|| anim == PLAYER_ANIM_TURNLEFT
+		|| anim == PLAYER_ANIM_TURNRIGHT;
+}
+
+static bool IsAirAnim(int anim)
+{
+	return anim == PLAYER_ANIM_JUMP1
+		|| anim == PLAYER_ANIM_JUMP2
+		|| anim == PLAYER_ANIM_FALLING;
+}
+
+/****************************/
+/*    PER-FRAME INPUT       */
+/****************************/
+
+void WebMove_Update(void)
+{
+	float dt = gFramesPerSecondFrac;
+
+	if (gJumpBuffer > 0)
+	{
+		gJumpBuffer -= dt;
+
+		// Once the double-jump window has passed, only keep the request if we're about to land
+		if (gPlayerObj && gPlayerObj->Delta.y < DOUBLE_JUMP_MIN_VY && gJumpBuffer > JUMP_BUFFER_LANDING
+			&& !(gPlayerObj->StatusBits & STATUS_BIT_ONGROUND))
+		{
+			gJumpBuffer = JUMP_BUFFER_LANDING;
+		}
+	}
+
+	float sx = 0, sy = 0;
+	bool held = Web_GetStick(&sx, &sy) && gPlayerObj && !gPlayerGotKilledFlag;
+	float mag = sqrtf(sx*sx + sy*sy);
+
+	if (!held || mag < STICK_DEADZONE)
+	{
+		gSteering = false;
+		gThrottle = 0;
+
+		// Keep the reference for a moment so a finger swinging through the center doesn't re-aim
+		gDeadzoneTime += dt;
+		if (!held || gDeadzoneTime > RELOCK_DELAY)
+			gLocked = false;
+		return;
+	}
+
+	gDeadzoneTime = 0;
+
+	if (!gLocked)
+	{
+		gRefHeading = GetIdealCameraHeading();
+		gLocked = true;
+	}
+
+	float stickAngle = atan2f(sx, -sy);				// 0 = up the screen, +PI/2 = right
+	gTargetHeading = WrapAngle(gRefHeading - stickAngle);	// increasing Rot.y turns left
+
+	float t = (mag - STICK_DEADZONE) / (STICK_FULL - STICK_DEADZONE);
+	t = SDL_clamp(t, 0.0f, 1.0f);
+	gThrottle = 0.30f + 0.70f * t;					// even a light push walks at a useful pace
+	gSteering = true;
+}
+
+bool WebMove_IsSteering(void)
+{
+	return gSteering;
+}
+
+KeyControlType WebMove_AdjustControlBits(KeyControlType bits)
+{
+	if (gSteering && gPlayerObj)
+	{
+		float diff = WrapAngle(gTargetHeading - gPlayerObj->Rot.y);
+
+		bits &= ~(KEYCONTROL_ROTLEFT | KEYCONTROL_ROTRIGHT | KEYCONTROL_BACKWARD);
+		bits |= KEYCONTROL_FORWARD;
+
+		// Turning on the spot: use the game's turn animations
+		if (fabsf(gPlayerObj->Speed) < TURN_IN_PLACE_SPEED
+			&& fabsf(diff) > TURN_IN_PLACE_ANGLE
+			&& (gPlayerObj->StatusBits & STATUS_BIT_ONGROUND))
+		{
+			bits |= (diff > 0) ? KEYCONTROL_ROTLEFT : KEYCONTROL_ROTRIGHT;
+		}
+	}
+
+	if (gJumpBuffer > 0)
+		bits |= KEYCONTROL_JUMP;
+
+	return bits;
+}
+
+/****************************/
+/*    JUMP                  */
+/****************************/
+
+void WebMove_RequestJump(void)
+{
+	if (!gPlayerObj || !gPlayerObj->Skeleton)
+		return;
+
+	int anim = gPlayerObj->Skeleton->AnimNum;
+
+	if (anim == PLAYER_ANIM_JUMP2)						// double jump already used
+		return;
+
+	if (anim == PLAYER_ANIM_JUMP1 || anim == PLAYER_ANIM_FALLING)
+	{
+		if (gPlayerObj->Delta.y >= DOUBLE_JUMP_MIN_VY)
+			gJumpBuffer = JUMP_BUFFER_AIR;				// fire the double jump as soon as it's allowed
+		else
+			gJumpBuffer = JUMP_BUFFER_LANDING;			// window missed; jump on landing if it's imminent
+	}
+	else
+		gJumpBuffer = JUMP_BUFFER_GROUND;
+}
+
+void WebMove_OnJumped(void)
+{
+	gJumpBuffer = 0;
+}
+
+/****************************/
+/*    TURNING               */
+/****************************/
+
+void WebMove_ApplyTurn(ObjNode* theNode, bool jetpack)
+{
+	if (!gSteering)
+		return;
+
+	int anim = theNode->Skeleton ? theNode->Skeleton->AnimNum : PLAYER_ANIM_STAND;
+	bool air = jetpack || IsAirAnim(anim);
+
+	float gain = air ? AIR_TURN_GAIN : GROUND_TURN_GAIN;
+	float maxRate = jetpack ? JET_TURN_MAX : (air ? AIR_TURN_MAX : GROUND_TURN_MAX);
+
+	float diff = WrapAngle(gTargetHeading - theNode->Rot.y);
+	float rate = SDL_clamp(diff * gain, -maxRate, maxRate);
+	float step = rate * gFramesPerSecondFrac;
+
+	if (fabsf(step) > fabsf(diff))					// don't overshoot at low frame rates
+		step = diff;
+
+	theNode->Rot.y += step;
+
+	if (jetpack)
+		theNode->Accel = PLAYER_WALK_ACCEL * 0.3f * gThrottle * SDL_max(0.0f, cosf(diff));
+}
+
+/****************************/
+/*    VELOCITY              */
+/****************************/
+//
+// Called from DoPlayerMovement before the walking vector is applied.
+// Returns true if it took over the player's horizontal velocity (the caller then skips
+// the keyboard-style acceleration).
+//
+
+bool WebMove_ShapeVelocity(ObjNode* theNode)
+{
+	if (!Web_IsTouchMode() || !theNode->Skeleton)
+		return false;
+
+	const float dt = gFramesPerSecondFrac;
+	const int anim = theNode->Skeleton->AnimNum;
+	const bool onGround = (theNode->StatusBits & STATUS_BIT_ONGROUND) != 0;
+
+	if (theNode->JetThrust)
+		return false;									// jetpack keeps its own floaty physics
+
+	/* FINGER DOWN: STEER */
+
+	if (gSteering && (IsGroundLocomotionAnim(anim) || IsAirAnim(anim)))
+	{
+		const bool air = IsAirAnim(anim) || !onGround;
+
+		float r = theNode->Rot.y;
+		float fx = -sinf(r), fz = -cosf(r);				// facing
+
+		float forward = gDelta.x * fx + gDelta.z * fz;
+		float latX = gDelta.x - forward * fx;
+		float latZ = gDelta.z - forward * fz;
+
+		float diff = WrapAngle(gTargetHeading - r);
+		float align = SDL_max(0.0f, cosf(diff));
+		align *= align;									// mostly turn first, then run
+
+		float maxSpeed = PLAYER_MAX_WALK_SPEED;
+		if ((gMyLatestTileAttribs & (TILE_ATTRIB_WATER|TILE_ATTRIB_LAVA)) && onGround)
+			maxSpeed *= 0.5f;
+
+		float target = maxSpeed * gThrottle * align;
+
+		if (air)
+		{
+			if (forward < target)						// in the air: can speed up, never brakes
+				forward = SDL_min(target, forward + AIR_ACCEL * dt);
+			float keep = expf(-AIR_GRIP * dt);
+			latX *= keep;
+			latZ *= keep;
+		}
+		else
+		{
+			forward = Approach(forward, target, GROUND_ACCEL, GROUND_DECEL, dt);
+			float keep = expf(-GROUND_GRIP * dt);
+			latX *= keep;
+			latZ *= keep;
+		}
+
+		gDelta.x = forward * fx + latX;
+		gDelta.z = forward * fz + latZ;
+		theNode->Accel = 0;
+		return true;
+	}
+
+	/* FINGER UP: STOP */
+
+	bool keyboardMoving = GetNeedState(kNeed_Forward) || GetNeedState(kNeed_Backward);
+	bool brakeAnim = IsGroundLocomotionAnim(anim)
+		|| anim == PLAYER_ANIM_LANDING
+		|| anim == PLAYER_ANIM_PICKUP
+		|| anim == PLAYER_ANIM_THROW;
+
+	if (!keyboardMoving && onGround && brakeAnim && !(gMyLatestPathTileNum & PATH_TILE_SLOPEFORCE))
+	{
+		float keep = expf(-RELEASE_BRAKE * dt);
+		gDelta.x *= keep;
+		gDelta.z *= keep;
+		if (gDelta.x * gDelta.x + gDelta.z * gDelta.z < RELEASE_STOP_SPEED * RELEASE_STOP_SPEED)
+		{
+			gDelta.x = 0;
+			gDelta.z = 0;
+		}
+		theNode->Accel = 0;
+		return true;
+	}
+
+	return false;
+}
