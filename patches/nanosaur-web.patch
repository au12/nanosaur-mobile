+/****************************/
+/*    MATRICES              */
+/****************************/
+
+void WebGL_MatrixMode(GLenum mode)
+{
+	EnsureInit();
+	S.matrixMode = mode;
+}
+
+void WebGL_LoadMatrixf(const GLfloat* m)
+{
+	EnsureInit();
+	memcpy(CurrentMatrix()->m, m, sizeof(float) * 16);
+	TouchMatrix();
+}
+
+void WebGL_LoadIdentity(void)
+{
+	EnsureInit();
+	Mat4_Identity(CurrentMatrix());
+	TouchMatrix();
+}
+
+void WebGL_MultMatrixf(const GLfloat* m)
+{
+	EnsureInit();
+	Mat4 b;
+	memcpy(b.m, m, sizeof(b.m));
+	Mat4* cur = CurrentMatrix();
+	Mat4_Mul(cur, &b, cur);
+	TouchMatrix();
+}
+
+void WebGL_PushMatrix(void)
+{
+	EnsureInit();
+	switch (S.matrixMode)
+	{
+		case LGL_PROJECTION:
+			if (S.projTop < 7) { S.projStack[S.projTop+1] = S.projStack[S.projTop]; S.projTop++; }
+			else S.pendingError = GL_INVALID_OPERATION;
+			break;
+		case LGL_TEXTURE:
+			if (S.texTop < 1) { S.texStack[S.texTop+1] = S.texStack[S.texTop]; S.texTop++; }
+			break;
+		default:
+			if (S.mvTop < MAX_STACK-1) { S.mvStack[S.mvTop+1] = S.mvStack[S.mvTop]; S.mvTop++; }
+			else S.pendingError = GL_INVALID_OPERATION;
+			break;
+	}
+}
+
+void WebGL_PopMatrix(void)
+{
+	EnsureInit();
+	switch (S.matrixMode)
+	{
+		case LGL_PROJECTION:	if (S.projTop > 0) S.projTop--; break;
+		case LGL_TEXTURE:		if (S.texTop > 0) S.texTop--; break;
+		default:				if (S.mvTop > 0) S.mvTop--; break;
+	}
+	TouchMatrix();
+}
+
+void WebGL_Ortho(GLdouble l, GLdouble r, GLdouble b, GLdouble t, GLdouble n, GLdouble f)
+{
+	EnsureInit();
+	Mat4 o;
+	Mat4_Identity(&o);
+	o.m[0]  = (float)(2.0 / (r - l));
+	o.m[5]  = (float)(2.0 / (t - b));
+	o.m[10] = (float)(-2.0 / (f - n));
+	o.m[12] = (float)(-(r + l) / (r - l));
+	o.m[13] = (float)(-(t + b) / (t - b));
+	o.m[14] = (float)(-(f + n) / (f - n));
+	Mat4* cur = CurrentMatrix();
+	Mat4_Mul(cur, &o, cur);
+	TouchMatrix();
+}
+
+void WebGL_GetFloatv(GLenum pname, GLfloat* data)
+{
+	EnsureInit();
+	switch (pname)
+	{
+		case LGL_MODELVIEW_MATRIX:	memcpy(data, S.mvStack[S.mvTop].m, sizeof(float)*16); return;
+		case LGL_PROJECTION_MATRIX:	memcpy(data, S.projStack[S.projTop].m, sizeof(float)*16); return;
+		default:					glGetFloatv(pname, data); return;
+	}
+}
+
+void WebGL_GetIntegerv(GLenum pname, GLint* data)
+{
+	EnsureInit();
+	switch (pname)
+	{
+		case LGL_UNPACK_ROW_LENGTH:	*data = S.unpackRowLength; return;
+		default:					glGetIntegerv(pname, data); return;
+	}
+}
+
+const GLubyte* WebGL_GetString(GLenum name)
+{
+	return glGetString(name);
+}
+
+GLenum WebGL_GetError(void)
+{
+	// glGetError is a synchronous round-trip to the GPU process in browsers, which stalls the
+	// pipeline. The game calls it after nearly every GL call, so only report our own errors.
+	GLenum e = S.pendingError;
+	S.pendingError = GL_NO_ERROR;
+#if _DEBUG
+	if (e == GL_NO_ERROR)
+		e = glGetError();
+#endif
+	return e;
+}
