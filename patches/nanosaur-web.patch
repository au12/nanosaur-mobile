+	if (Module.nanoEvent) Module.nanoEvent(UTF8ToString(type), a, b);
+});
+
+EM_JS(void, js_event_s, (const char* type, const char* s, int a), {
+	if (Module.nanoEvent) Module.nanoEvent(UTF8ToString(type), UTF8ToString(s), a);
+});
+
+EM_JS(void, js_hud, (int time, int score, int health, int lives, int weapon, int ammo,
+					 int fuelFrame, int eggs, int flags, int weaponMask), {
+	if (Module.nanoHUD) Module.nanoHUD(time, score, health, lives, weapon, ammo, fuelFrame, eggs, flags, weaponMask);
+});
+
+EM_ASYNC_JS(void, js_wait_frame, (), {
+	await new Promise((resolve) => {
+		if (Module.nanoWaitFrame) Module.nanoWaitFrame(resolve);
+		else requestAnimationFrame(() => resolve());
+	});
+});
+
+EM_ASYNC_JS(void, js_mount_persist, (), {
+	try { FS.mkdir('/persist'); } catch (e) {}
+	try { FS.mount(IDBFS, { autoPersist: false }, '/persist'); } catch (e) { console.warn('IDBFS mount failed', e); }
+	await new Promise((resolve) => {
+		try { FS.syncfs(true, (err) => { if (err) console.warn('IDBFS load failed', err); resolve(); }); }
+		catch (e) { console.warn(e); resolve(); }
+	});
+});
+
+EM_JS(void, js_sync_persist, (), {
+	if (Module.__nanoSyncTimer) clearTimeout(Module.__nanoSyncTimer);
+	Module.__nanoSyncTimer = setTimeout(() => {
+		Module.__nanoSyncTimer = 0;
+		try { FS.syncfs(false, (err) => { if (err) console.warn('IDBFS save failed', err); }); } catch (e) {}
+	}, 150);
+});
