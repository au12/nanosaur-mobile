+// WEBGLREDIRECT.H
+// Force-included into every game translation unit in the Emscripten build.
+//
+// Nanosaur renders with a small subset of legacy fixed-function OpenGL (matrix stacks,
+// client-side vertex arrays, per-vertex lighting, linear fog, alpha test and Mac-style
+// packed pixel formats). None of that exists in WebGL2, so the calls below are renamed
+// to a compact emulation layer (WebGL_FFP.c) that implements them on top of GLES3/WebGL2.
+// Calls that map 1:1 onto WebGL2 (glClear, glViewport, glBlendFunc, ...) go straight
+// through to Emscripten's WebGL bindings.
+
+#pragma once
+
+#if defined(__EMSCRIPTEN__) && !defined(NANOSAUR_WEBGL_FFP_IMPL)
+
+#include <stdbool.h>
+#include <SDL3/SDL_opengl.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct SDL_Window;
+
+void			WebGL_Enable(GLenum cap);
+void			WebGL_Disable(GLenum cap);
+void			WebGL_EnableClientState(GLenum array);
+void			WebGL_DisableClientState(GLenum array);
+void			WebGL_MatrixMode(GLenum mode);
+void			WebGL_LoadMatrixf(const GLfloat* m);
+void			WebGL_LoadIdentity(void);
+void			WebGL_PushMatrix(void);
+void			WebGL_PopMatrix(void);
+void			WebGL_MultMatrixf(const GLfloat* m);
+void			WebGL_Ortho(GLdouble l, GLdouble r, GLdouble b, GLdouble t, GLdouble n, GLdouble f);
+void			WebGL_GetFloatv(GLenum pname, GLfloat* data);
+void			WebGL_GetIntegerv(GLenum pname, GLint* data);
+const GLubyte*	WebGL_GetString(GLenum name);
+GLenum			WebGL_GetError(void);
+void			WebGL_Lightfv(GLenum light, GLenum pname, const GLfloat* params);
+void			WebGL_LightModelfv(GLenum pname, const GLfloat* params);
+void			WebGL_ColorMaterial(GLenum face, GLenum mode);
+void			WebGL_Color4f(GLfloat r, GLfloat g, GLfloat b, GLfloat a);
+void			WebGL_Fogf(GLenum pname, GLfloat param);
+void			WebGL_Fogi(GLenum pname, GLint param);
