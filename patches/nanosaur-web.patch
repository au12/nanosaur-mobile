+#if __EMSCRIPTEN__
+	// When both keys of an opposing pair are down, the one pressed most recently wins
+	// (the original always favored left/forward, so pressing right couldn't override left).
+	{
+		static int lastTurn = 0, lastMove = 0;
+
+		if (GetNewNeedState(kNeed_TurnLeft))	lastTurn = -1;
