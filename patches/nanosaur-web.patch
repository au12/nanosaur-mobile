+// --- Key bindings ---
+
+EMSCRIPTEN_KEEPALIVE int Web_GetKeyBinding(int needID, int slot)
+{
+	if (needID < 0 || needID >= NUM_REMAPPABLE_NEEDS || slot < 0 || slot >= KEYBINDING_MAX_KEYS)
+		return 0;
+	return gGamePrefs.keys[needID].key[slot];
+}
+
+EMSCRIPTEN_KEEPALIVE int Web_GetDefaultKeyBinding(int needID, int slot)
+{
+	if (needID < 0 || needID >= NUM_REMAPPABLE_NEEDS || slot < 0 || slot >= KEYBINDING_MAX_KEYS)
+		return 0;
+	if (js_is_mac() && (needID == kNeed_Jump || needID == kNeed_PickUp))
+	{
+		static const int16_t mac[2][2] = { {SDL_SCANCODE_LALT, SDL_SCANCODE_RALT}, {WEB_MAC_PICKUP_KEY, 0} };
+		return mac[needID == kNeed_Jump ? 0 : 1][slot];
+	}
+	return kDefaultKeyBindings[needID].key[slot];
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_SetKeyBinding(int needID, int slot, int scancode)
+{
+	if (needID < 0 || needID >= NUM_REMAPPABLE_NEEDS || slot < 0 || slot >= KEYBINDING_MAX_KEYS)
+		return;
+	if (scancode < 0 || scancode >= SDL_SCANCODE_COUNT || IsGuiScancode(scancode))
+		return;
+
+	// Unbind this scancode from other remappable needs (same behavior as the in-game screen)
+	if (scancode != 0)
+	{
+		for (int i = 0; i < NUM_REMAPPABLE_NEEDS; i++)
+			for (int j = 0; j < KEYBINDING_MAX_KEYS; j++)
+				if (gGamePrefs.keys[i].key[j] == scancode)
+					gGamePrefs.keys[i].key[j] = 0;
+	}
+	gGamePrefs.keys[needID].key[slot] = (int16_t) scancode;
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_ResetKeyBindings(void)
+{
+	SDL_memcpy(gGamePrefs.keys, kDefaultKeyBindings, sizeof(gGamePrefs.keys));
+	Web_ApplyPlatformDefaultKeys();
+}
+
+EMSCRIPTEN_KEEPALIVE const char* Web_GetScancodeName(int scancode)
+{
+	if (scancode <= 0 || scancode >= SDL_SCANCODE_COUNT)
+		return "";
+	return SDL_GetScancodeName((SDL_Scancode) scancode);
+}
+
+EMSCRIPTEN_KEEPALIVE int Web_GetNumRemappableNeeds(void)
+{
+	return NUM_REMAPPABLE_NEEDS;
+}
+
+// --- Prefs ---
+
+enum
+{
+	kWebPref_Extreme = 0,
+	kWebPref_Music,
+	kWebPref_AmbientSounds,
+	kWebPref_Force4x3,
+	kWebPref_HighQualityTextures,
+	kWebPref_Fog,
+	kWebPref_WhiteSky,
+	kWebPref_TeethFix,
+	kWebPref_MainMenuHelp,
+	kWebPref_HUDStyle,
+	kWebPref_Antialiasing,
+	kWebPref_Shadows,
+	kNumWebPrefs
+};
+
+static Byte* GetPrefPtr(int id)
+{
+	switch (id)
+	{
+		case kWebPref_Extreme:				return (Byte*) &gGamePrefs.extreme;
+		case kWebPref_Music:				return (Byte*) &gGamePrefs.music;
+		case kWebPref_AmbientSounds:		return (Byte*) &gGamePrefs.ambientSounds;
+		case kWebPref_Force4x3:				return (Byte*) &gGamePrefs.force4x3;
+		case kWebPref_HighQualityTextures:	return (Byte*) &gGamePrefs.highQualityTextures;
+		case kWebPref_Fog:					return (Byte*) &gGamePrefs.canDoFog;
+		case kWebPref_WhiteSky:				return (Byte*) &gGamePrefs.whiteSky;
+		case kWebPref_TeethFix:				return (Byte*) &gGamePrefs.nanosaurTeethFix;
+		case kWebPref_MainMenuHelp:			return (Byte*) &gGamePrefs.mainMenuHelp;
+		case kWebPref_HUDStyle:				return (Byte*) &gGamePrefs.hudStyle;
+		case kWebPref_Antialiasing:			return (Byte*) &gGamePrefs.antialiasingLevel;
+		case kWebPref_Shadows:				return (Byte*) &gGamePrefs.shadows;
+		default:							return NULL;
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE int Web_GetPref(int id)
+{
+	Byte* p = GetPrefPtr(id);
+	return p ? (int) *p : -1;
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_SetPref(int id, int value)
+{
+	Byte* p = GetPrefPtr(id);
+	if (!p)
+		return;
+
+	Byte old = *p;
+	*p = (Byte) value;
+	if (old == *p)
+		return;
+
+	gSettingsDirty = true;
+
+	switch (id)
+	{
+		case kWebPref_Extreme:
+			SetProModeSettings(gGamePrefs.extreme);
+			break;
+
+		case kWebPref_HUDStyle:
+			Web_ApplyHUDStyleLive();
+			break;
+
+		case kWebPref_Music:
+			if (!gGamePrefs.music)
+				KillSong();
+			else if (gWebScreen != kWebScreen_Movie)
+				PlaySong(gWebScreen == kWebScreen_Game || gWebScreen == kWebScreen_Paused ? 0 : 1, true);
+			break;
+
+		default:
+			break;
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_SavePrefs(void)
+{
+	SavePrefs(&gGamePrefs);
+}
+
+EMSCRIPTEN_KEEPALIVE void Web_PauseGame(void)
+{
+	if (gWebScreen == kWebScreen_Game)
+		Web_SetVirtualNeed(kNeed_UIPause, 2);
+}
+
+// Diagnostics for the shell's ?debug overlay and automated control tests:
+// [rotY, speed, deltaX, deltaZ, anim, x, z, deltaY]
+EMSCRIPTEN_KEEPALIVE float* Web_DebugState(void)
+{
+	static float st[8];
+	SDL_memset(st, 0, sizeof(st));
+	if (gPlayerObj && gTerrainPtr)
+	{
+		st[0] = gPlayerObj->Rot.y;
+		st[1] = gPlayerObj->Speed;
+		st[2] = gPlayerObj->Delta.x;
+		st[3] = gPlayerObj->Delta.z;
+		st[4] = gPlayerObj->Skeleton ? gPlayerObj->Skeleton->AnimNum : -1;
+		st[5] = gPlayerObj->Coord.x;
+		st[6] = gPlayerObj->Coord.z;
+		st[7] = gPlayerObj->Delta.y;
+	}
+	return st;
+}
+
+EMSCRIPTEN_KEEPALIVE int Web_GetMainMenuSelection(void)
+{
+	return gCurrentSelection;
+}
