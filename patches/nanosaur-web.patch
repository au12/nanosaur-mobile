+void WebGL_Color4f(GLfloat r, GLfloat g, GLfloat b, GLfloat a)
+{
+	S.color[0] = r; S.color[1] = g; S.color[2] = b; S.color[3] = a;
+}
+
+void WebGL_Fogf(GLenum pname, GLfloat param)
+{
+	EnsureInit();
+	switch (pname)
+	{
+		case LGL_FOG_START:		S.fogStart = param; break;
+		case LGL_FOG_END:		S.fogEnd = param; break;
+		case LGL_FOG_DENSITY:	S.fogDensity = param; break;
+		case LGL_FOG_MODE:		S.fogMode = (GLenum) param; break;
+		default: return;
+	}
+	S.fogSerial++;
+}
+
+void WebGL_Fogi(GLenum pname, GLint param)
+{
+	WebGL_Fogf(pname, (GLfloat) param);
+}
+
+void WebGL_Fogfv(GLenum pname, const GLfloat* params)
+{
+	EnsureInit();
+	if (pname == LGL_FOG_COLOR)
