diff --git a/src/Web/WebGL_FFP.c b/src/Web/WebGL_FFP.c
new file mode 100644
index 0000000..36afea3
--- /dev/null
+++ b/src/Web/WebGL_FFP.c
@@ -0,0 +1,1286 @@
+// WEBGL_FFP.C
+// Fixed-function OpenGL 1.x emulation on top of WebGL2 (GLES 3.0) for the Nanosaur web port.
+//
+// Implements exactly the subset of legacy GL the game uses:
+//   - modelview/projection matrix stacks, glOrtho, glGetFloatv(matrices)
+//   - client-side vertex/normal/color/texcoord arrays + glDrawElements
+//   - per-vertex Gouraud lighting with directional lights, scene ambient, GL_COLOR_MATERIAL
+//   - linear/exp/exp2 fog, alpha test, GL_MODULATE texturing
+//   - Mac-style packed texture formats (BGRA + 1_5_5_5_REV / 8_8_8_8) with GL_UNPACK_ROW_LENGTH
+//
+// Client arrays are streamed into ring-buffered VBOs. One shader program is generated per
+// combination of {lighting, texturing, fog, alpha test} and cached.
+
+#ifndef NANOSAUR_WEBGL_FFP_IMPL
+#define NANOSAUR_WEBGL_FFP_IMPL 1
+#endif
+
+#include <GLES3/gl3.h>
+#include <emscripten.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+/****************************/
+/*    LEGACY GL ENUMS       */
+/****************************/
+
+#define LGL_MODELVIEW				0x1700
+#define LGL_PROJECTION				0x1701
+#define LGL_TEXTURE					0x1702
+#define LGL_MODELVIEW_MATRIX		0x0BA6
+#define LGL_PROJECTION_MATRIX		0x0BA7
+#define LGL_LIGHTING				0x0B50
+#define LGL_LIGHT0					0x4000
+#define LGL_FOG						0x0B60
+#define LGL_FOG_DENSITY				0x0B62
+#define LGL_FOG_START				0x0B63
+#define LGL_FOG_END					0x0B64
+#define LGL_FOG_MODE				0x0B65
+#define LGL_FOG_COLOR				0x0B66
+#define LGL_EXP						0x0800
+#define LGL_EXP2					0x0801
+#define LGL_NORMALIZE				0x0BA1
+#define LGL_RESCALE_NORMAL			0x803A
+#define LGL_ALPHA_TEST				0x0BC0
+#define LGL_COLOR_MATERIAL			0x0B57
+#define LGL_VERTEX_ARRAY			0x8074
+#define LGL_NORMAL_ARRAY			0x8075
+#define LGL_COLOR_ARRAY				0x8076
+#define LGL_TEXTURE_COORD_ARRAY		0x8078
+#define LGL_AMBIENT					0x1200
+#define LGL_DIFFUSE					0x1201
+#define LGL_SPECULAR				0x1202
+#define LGL_POSITION				0x1203
+#define LGL_LIGHT_MODEL_AMBIENT		0x0B53
+#define LGL_AMBIENT_AND_DIFFUSE		0x1602
+#define LGL_BGRA					0x80E1
+#define LGL_UNSIGNED_SHORT_1_5_5_5_REV	0x8366
+#define LGL_UNSIGNED_INT_8_8_8_8		0x8035
+#define LGL_UNSIGNED_INT_8_8_8_8_REV	0x8367
+#define LGL_UNPACK_ROW_LENGTH		0x0CF2
+#define LGL_TEXTURE_2D				0x0DE1
+#define LGL_CLAMP					0x2900
+#define LGL_LINE_SMOOTH				0x0B20
+#define LGL_POLYGON_SMOOTH			0x0B41
+#define LGL_MULTISAMPLE				0x809D
+
+typedef double GLdouble;
+
+#define MAX_LIGHTS					4
+#define MAX_STACK					32
+
+enum
+{
+	kAttribPos		= 0,
+	kAttribNormal	= 1,
+	kAttribColor	= 2,
+	kAttribUV		= 3,
+};
+
+enum
+{
+	kFeatLighting	= 1 << 0,
+	kFeatTexture	= 1 << 1,
+	kFeatFog		= 1 << 2,
+	kFeatAlphaTest	= 1 << 3,
+	kNumVariants	= 1 << 4,
+};
+
+typedef struct { float m[16]; } Mat4;
+
+typedef struct
+{
+	bool		enabled;
+	float		eyeDir[4];		// eye-space position/direction (as stored by glLightfv(GL_POSITION))
+	float		ambient[4];
+	float		diffuse[4];
+} Light;
+
+typedef struct
+{
+	bool			enabled;
+	GLint			size;
+	GLenum			type;
+	GLsizei			stride;
+	const void*		ptr;
+} ClientArray;
+
+typedef struct
+{
+	GLuint	program;
+	GLint	uMV, uProj, uNormalMat;
+	GLint	uNumLights, uLightDir, uLightAmb, uLightDiff, uSceneAmbient;
+	GLint	uMatAmbient, uMatDiffuse, uColorMaterial;
+	GLint	uFogParams, uFogColor;
+	GLint	uAlphaRef;
+	GLint	uTex;
+	uint32_t	seenMatrixSerial;
+	uint32_t	seenLightSerial;
+	uint32_t	seenFogSerial;
+	uint32_t	seenMiscSerial;
+} Program;
+
+enum { kTexKind_None = 0, kTexKind_RGBA8, kTexKind_RGB5A1, kTexFlag_Opaque = 0x80 };
+
+/****************************/
+/*    STATE                 */
+/****************************/
+
+static struct
+{
+	bool		initialized;
+
+	// Matrix stacks
+	GLenum		matrixMode;
+	Mat4		mvStack[MAX_STACK];
+	int			mvTop;
+	Mat4		projStack[8];
+	int			projTop;
+	Mat4		texStack[2];
+	int			texTop;
+	uint32_t	matrixSerial;
+
+	// Capabilities
+	bool		lighting;
+	bool		fog;
+	bool		texture2D;
+	bool		alphaTest;
+	bool		colorMaterial;
+
+	// Lighting
+	Light		lights[8];
+	float		sceneAmbient[4];
+	float		matAmbient[4];
+	float		matDiffuse[4];
+	uint32_t	lightSerial;
+
+	// Fog
+	GLenum		fogMode;
+	float		fogStart, fogEnd, fogDensity;
+	float		fogColor[4];
+	uint32_t	fogSerial;
+
+	// Alpha test
+	GLenum		alphaFunc;
+	float		alphaRef;
+	uint32_t	miscSerial;
+
+	// Current color
+	float		color[4];
+
+	// Client arrays
+	ClientArray	arrays[4];
+
+	// Pixel store
+	GLint		unpackRowLength;
+
+	// Textures
+	GLuint		boundTexture;
+	uint8_t*	texKinds;
+	int			texKindsCap;
+
+	// GPU objects
+	GLuint		vao;
+	GLuint		vbo;
+	GLuint		ibo;
+	GLsizeiptr	vboCap, vboOff;
+	GLsizeiptr	iboCap, iboOff;
+	Program		programs[kNumVariants];
+	int			currentProgram;
+
+	// Scratch buffers
+	uint8_t*	scratch;
+	size_t		scratchCap;
+	uint8_t*	pixScratch;
+	size_t		pixScratchCap;
+
+	GLenum		pendingError;
+} S;
+
+/****************************/
+/*    MATRIX HELPERS        */
+/****************************/
+
+static void Mat4_Identity(Mat4* m)
+{
+	memset(m, 0, sizeof(*m));
+	m->m[0] = m->m[5] = m->m[10] = m->m[15] = 1.0f;
+}
+
+// out = a * b (column-major, like OpenGL)
+static void Mat4_Mul(const Mat4* a, const Mat4* b, Mat4* out)
+{
+	Mat4 r;
+	for (int c = 0; c < 4; c++)
+	{
+		for (int row = 0; row < 4; row++)
+		{
+			r.m[c*4+row] =
+				a->m[0*4+row] * b->m[c*4+0] +
+				a->m[1*4+row] * b->m[c*4+1] +
+				a->m[2*4+row] * b->m[c*4+2] +
+				a->m[3*4+row] * b->m[c*4+3];
+		}
+	}
+	*out = r;
+}
+
+static Mat4* CurrentMatrix(void)
+{
+	switch (S.matrixMode)
+	{
+		case LGL_PROJECTION:	return &S.projStack[S.projTop];
+		case LGL_TEXTURE:		return &S.texStack[S.texTop];
+		default:				return &S.mvStack[S.mvTop];
+	}
+}
+
+static void TouchMatrix(void)
+{
+	S.matrixSerial++;
+}
+
+// Upper-left 3x3 of the inverse-transpose of the modelview matrix
+static void CalcNormalMatrix(const Mat4* mv, float out[9])
+{
+	const float* m = mv->m;
+	float a00 = m[0], a01 = m[1], a02 = m[2];
+	float a10 = m[4], a11 = m[5], a12 = m[6];
+	float a20 = m[8], a21 = m[9], a22 = m[10];
+
+	float b01 = a22 * a11 - a12 * a21;
+	float b11 = -a22 * a10 + a12 * a20;
+	float b21 = a21 * a10 - a11 * a20;
+
+	float det = a00 * b01 + a01 * b11 + a02 * b21;
+	if (fabsf(det) < 1e-12f)
+		det = 1.0f;
+	float id = 1.0f / det;
+
+	// inverse (column-major)
+	float inv[9];
+	inv[0] = b01 * id;
+	inv[1] = (-a22 * a01 + a02 * a21) * id;
+	inv[2] = (a12 * a01 - a02 * a11) * id;
+	inv[3] = b11 * id;
+	inv[4] = (a22 * a00 - a02 * a20) * id;
+	inv[5] = (-a12 * a00 + a02 * a10) * id;
+	inv[6] = b21 * id;
+	inv[7] = (-a21 * a00 + a01 * a20) * id;
+	inv[8] = (a11 * a00 - a01 * a10) * id;
+
+	// transpose
+	out[0] = inv[0]; out[1] = inv[3]; out[2] = inv[6];
+	out[3] = inv[1]; out[4] = inv[4]; out[5] = inv[7];
+	out[6] = inv[2]; out[7] = inv[5]; out[8] = inv[8];
+}
+
+/****************************/
+/*    SHADERS               */
+/****************************/
+
+static const char* kVertexShaderBody =
+	"layout(location=0) in vec4 aPos;\n"
+	"layout(location=1) in vec3 aNormal;\n"
+	"layout(location=2) in vec4 aColor;\n"
+	"layout(location=3) in vec2 aUV;\n"
+	"uniform mat4 uMV;\n"
+	"uniform mat4 uProj;\n"
+	"uniform mat3 uNormalMat;\n"
+	"out vec4 vColor;\n"
+	"out vec2 vUV;\n"
+	"out float vFogZ;\n"
+	"#ifdef LIGHTING\n"
+	"uniform int uNumLights;\n"
+	"uniform vec3 uLightDir[4];\n"
+	"uniform vec3 uLightAmb[4];\n"
+	"uniform vec3 uLightDiff[4];\n"
+	"uniform vec3 uSceneAmbient;\n"
+	"uniform vec4 uMatAmbient;\n"
+	"uniform vec4 uMatDiffuse;\n"
+	"uniform bool uColorMaterial;\n"
+	"#endif\n"
+	"void main() {\n"
+	"  vec4 eye = uMV * aPos;\n"
+	"  gl_Position = uProj * eye;\n"
+	"  vFogZ = abs(eye.z);\n"
+	"  vUV = aUV;\n"
+	"#ifdef LIGHTING\n"
+	"  vec4 amb = uColorMaterial ? aColor : uMatAmbient;\n"
+	"  vec4 dif = uColorMaterial ? aColor : uMatDiffuse;\n"
+	"  vec3 n = normalize(uNormalMat * aNormal);\n"
+	"  vec3 c = uSceneAmbient * amb.rgb;\n"
+	"  for (int i = 0; i < 4; i++) {\n"
+	"    if (i >= uNumLights) break;\n"
+	"    float d = max(dot(n, uLightDir[i]), 0.0);\n"
+	"    c += uLightAmb[i] * amb.rgb + d * uLightDiff[i] * dif.rgb;\n"
+	"  }\n"
+	"  vColor = vec4(clamp(c, 0.0, 1.0), dif.a);\n"
+	"#else\n"
+	"  vColor = aColor;\n"
+	"#endif\n"
+	"}\n";
+
+static const char* kFragmentShaderBody =
+	"precision mediump float;\n"
+	"in vec4 vColor;\n"
+	"in vec2 vUV;\n"
+	"in highp float vFogZ;\n"
+	"out vec4 fragColor;\n"
+	"uniform sampler2D uTex;\n"
+	"uniform vec4 uFogParams;\n"		// x=start, y=end, z=density, w=mode (0 linear, 1 exp, 2 exp2)
+	"uniform vec3 uFogColor;\n"
+	"uniform float uAlphaRef;\n"
+	"void main() {\n"
+	"  vec4 c = vColor;\n"
+	"#ifdef TEXTURE\n"
+	"  c *= texture(uTex, vUV);\n"
+	"#endif\n"
+	"#ifdef ALPHATEST\n"
+	"  if (c.a <= uAlphaRef) discard;\n"
+	"#endif\n"
+	"#ifdef FOG\n"
+	"  float f;\n"
+	"  if (uFogParams.w < 0.5) f = (uFogParams.y - vFogZ) / max(uFogParams.y - uFogParams.x, 0.0001);\n"
+	"  else if (uFogParams.w < 1.5) f = exp(-uFogParams.z * vFogZ);\n"
+	"  else { float e = uFogParams.z * vFogZ; f = exp(-e * e); }\n"
+	"  c.rgb = mix(uFogColor, c.rgb, clamp(f, 0.0, 1.0));\n"
+	"#endif\n"
+	"  fragColor = c;\n"
+	"}\n";
+
+static GLuint CompileShader(GLenum type, const char* defines, const char* body)
+{
+	const char* sources[3] = { "#version 300 es\n", defines, body };
+	GLuint sh = glCreateShader(type);
+	glShaderSource(sh, 3, sources, NULL);
+	glCompileShader(sh);
+	GLint ok = 0;
+	glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+	if (!ok)
+	{
+		char log[2048];
+		glGetShaderInfoLog(sh, sizeof(log), NULL, log);
+		printf("[WebGL_FFP] shader compile error:\n%s\n", log);
+	}
+	return sh;
+}
+
+static Program* GetProgram(int variant)
+{
+	Program* p = &S.programs[variant];
+	if (p->program)
+		return p;
+
+	char defines[256];
+	snprintf(defines, sizeof(defines), "%s%s%s%s",
+		(variant & kFeatLighting)	? "#define LIGHTING\n"	: "",
+		(variant & kFeatTexture)	? "#define TEXTURE\n"	: "",
+		(variant & kFeatFog)		? "#define FOG\n"		: "",
+		(variant & kFeatAlphaTest)	? "#define ALPHATEST\n"	: "");
+
+	GLuint vs = CompileShader(GL_VERTEX_SHADER, defines, kVertexShaderBody);
+	GLuint fs = CompileShader(GL_FRAGMENT_SHADER, defines, kFragmentShaderBody);
+	GLuint prog = glCreateProgram();
+	glAttachShader(prog, vs);
+	glAttachShader(prog, fs);
+	glLinkProgram(prog);
+	GLint ok = 0;
+	glGetProgramiv(prog, GL_LINK_STATUS, &ok);
+	if (!ok)
+	{
+		char log[2048];
+		glGetProgramInfoLog(prog, sizeof(log), NULL, log);
+		printf("[WebGL_FFP] program link error:\n%s\n", log);
+	}
+	glDeleteShader(vs);
+	glDeleteShader(fs);
+
+	p->program			= prog;
+	p->uMV				= glGetUniformLocation(prog, "uMV");
+	p->uProj			= glGetUniformLocation(prog, "uProj");
+	p->uNormalMat		= glGetUniformLocation(prog, "uNormalMat");
+	p->uNumLights		= glGetUniformLocation(prog, "uNumLights");
+	p->uLightDir		= glGetUniformLocation(prog, "uLightDir");
+	p->uLightAmb		= glGetUniformLocation(prog, "uLightAmb");
+	p->uLightDiff		= glGetUniformLocation(prog, "uLightDiff");
+	p->uSceneAmbient	= glGetUniformLocation(prog, "uSceneAmbient");
+	p->uMatAmbient		= glGetUniformLocation(prog, "uMatAmbient");
+	p->uMatDiffuse		= glGetUniformLocation(prog, "uMatDiffuse");
+	p->uColorMaterial	= glGetUniformLocation(prog, "uColorMaterial");
+	p->uFogParams		= glGetUniformLocation(prog, "uFogParams");
+	p->uFogColor		= glGetUniformLocation(prog, "uFogColor");
+	p->uAlphaRef		= glGetUniformLocation(prog, "uAlphaRef");
+	p->uTex				= glGetUniformLocation(prog, "uTex");
+
+	glUseProgram(prog);
+	if (p->uTex >= 0)
+		glUniform1i(p->uTex, 0);
+	S.currentProgram = variant;
+
+	// Force full uniform upload on first use
+	p->seenMatrixSerial	= 0xFFFFFFFF;
+	p->seenLightSerial	= 0xFFFFFFFF;
+	p->seenFogSerial	= 0xFFFFFFFF;
+	p->seenMiscSerial	= 0xFFFFFFFF;
+	return p;
+}
+
+/****************************/
+/*    INIT                  */
+/****************************/
+
+static void EnsureInit(void)
+{
+	if (S.initialized)
+		return;
+
+	S.initialized = true;
+	S.matrixMode = LGL_MODELVIEW;
+	Mat4_Identity(&S.mvStack[0]);
+	Mat4_Identity(&S.projStack[0]);
+	Mat4_Identity(&S.texStack[0]);
+	S.matrixSerial = 1;
+
+	S.sceneAmbient[0] = S.sceneAmbient[1] = S.sceneAmbient[2] = 0.2f; S.sceneAmbient[3] = 1.0f;
+	S.matAmbient[0] = S.matAmbient[1] = S.matAmbient[2] = 0.2f; S.matAmbient[3] = 1.0f;
+	S.matDiffuse[0] = S.matDiffuse[1] = S.matDiffuse[2] = 0.8f; S.matDiffuse[3] = 1.0f;
+	for (int i = 0; i < 8; i++)
+	{
+		Light* l = &S.lights[i];
+		l->eyeDir[0] = 0; l->eyeDir[1] = 0; l->eyeDir[2] = 1; l->eyeDir[3] = 0;
+		l->ambient[3] = 1;
+		float d = (i == 0) ? 1.0f : 0.0f;
+		l->diffuse[0] = l->diffuse[1] = l->diffuse[2] = d; l->diffuse[3] = 1;
+	}
+	S.lightSerial = 1;
+
+	S.fogMode = LGL_EXP;
+	S.fogStart = 0; S.fogEnd = 1; S.fogDensity = 1;
+	S.fogSerial = 1;
+
+	S.alphaFunc = GL_ALWAYS;
+	S.alphaRef = 0;
+	S.miscSerial = 1;
+
+	S.color[0] = S.color[1] = S.color[2] = S.color[3] = 1.0f;
+	S.currentProgram = -1;
+
+	glGenVertexArrays(1, &S.vao);
+	glBindVertexArray(S.vao);
+
+	S.vboCap = 4 * 1024 * 1024;
+	glGenBuffers(1, &S.vbo);
+	glBindBuffer(GL_ARRAY_BUFFER, S.vbo);
+	glBufferData(GL_ARRAY_BUFFER, S.vboCap, NULL, GL_STREAM_DRAW);
+
+	S.iboCap = 1 * 1024 * 1024;
+	glGenBuffers(1, &S.ibo);
+	glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, S.ibo);
+	glBufferData(GL_ELEMENT_ARRAY_BUFFER, S.iboCap, NULL, GL_STREAM_DRAW);
+
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+	glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+}
+
+static void* Scratch(size_t bytes)
+{
+	if (bytes > S.scratchCap)
+	{
+		S.scratchCap = bytes + bytes / 2 + 4096;
+		S.scratch = realloc(S.scratch, S.scratchCap);
+	}
+	return S.scratch;
+}
+
+static void* PixScratch(size_t bytes)
+{
+	if (bytes > S.pixScratchCap)
+	{
+		S.pixScratchCap = bytes;
+		S.pixScratch = realloc(S.pixScratch, S.pixScratchCap);
+	}
+	return S.pixScratch;
+}
+
+/****************************/
+/*    CAPABILITIES          */
+/****************************/
+
+static void SetCap(GLenum cap, bool on)
+{
+	EnsureInit();
+
+	if (cap >= LGL_LIGHT0 && cap < LGL_LIGHT0 + 8)
+	{
+		S.lights[cap - LGL_LIGHT0].enabled = on;
+		S.lightSerial++;
+		return;
+	}
+
+	switch (cap)
+	{
+		case LGL_LIGHTING:			S.lighting = on; return;
+		case LGL_FOG:				S.fog = on; return;
+		case LGL_TEXTURE_2D:		S.texture2D = on; return;
+		case LGL_ALPHA_TEST:		S.alphaTest = on; return;
+		case LGL_COLOR_MATERIAL:	S.colorMaterial = on; S.lightSerial++; return;
+		case LGL_NORMALIZE:
+		case LGL_RESCALE_NORMAL:
+		case LGL_LINE_SMOOTH:
+		case LGL_POLYGON_SMOOTH:
+		case LGL_MULTISAMPLE:
+			return;		// always normalized in shader / not applicable
+
+		case GL_CULL_FACE:
+		case GL_DEPTH_TEST:
+		case GL_BLEND:
+		case GL_SCISSOR_TEST:
+		case GL_DITHER:
+		case GL_POLYGON_OFFSET_FILL:
+		case GL_SAMPLE_ALPHA_TO_COVERAGE:
+		case GL_SAMPLE_COVERAGE:
+		case GL_STENCIL_TEST:
+			if (on) glEnable(cap); else glDisable(cap);
+			return;
+
+		default:
+			return;		// silently ignore unknown legacy caps
+	}
+}
+
+void WebGL_Enable(GLenum cap)	{ SetCap(cap, true); }
+void WebGL_Disable(GLenum cap)	{ SetCap(cap, false); }
+
+static ClientArray* GetClientArray(GLenum array)
+{
+	switch (array)
+	{
+		case LGL_VERTEX_ARRAY:			return &S.arrays[kAttribPos];
+		case LGL_NORMAL_ARRAY:			return &S.arrays[kAttribNormal];
+		case LGL_COLOR_ARRAY:			return &S.arrays[kAttribColor];
+		case LGL_TEXTURE_COORD_ARRAY:	return &S.arrays[kAttribUV];
+		default:						return NULL;
+	}
+}
