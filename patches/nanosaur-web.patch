+		pane.right	= 12;
+		pane.top	= 9;
+		pane.bottom	= 110;
+	}
+	gGameViewInfoPtr->paneClip = pane;
+	gGameViewInfoPtr->needScissorTest = pane.left != 0 || pane.right != 0 || pane.top != 0 || pane.bottom != 0;
+	gInfobarUpdateBits = 0xFFFFFFFF;
