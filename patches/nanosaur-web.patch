+
+bool Web_WorldToWindow(float x, float y, float z, float* nx, float* ny)
+{
+	const TQ3Matrix4x4* m = &gCameraWorldToFrustumMatrix;
+	// QD3D row-vector convention: p' = p * M
+	float cx = x*m->value[0][0] + y*m->value[1][0] + z*m->value[2][0] + m->value[3][0];
+	float cy = x*m->value[0][1] + y*m->value[1][1] + z*m->value[2][1] + m->value[3][1];
+	float cw = x*m->value[0][3] + y*m->value[1][3] + z*m->value[2][3] + m->value[3][3];
+	if (cw <= 0.0001f)
+		return false;
+	float ndcX = cx / cw;
+	float ndcY = cy / cw;
+
+	// Viewport is in GL coords (origin bottom-left)
+	float px = gViewport[0] + (ndcX * 0.5f + 0.5f) * gViewport[2];
+	float pyGL = gViewport[1] + (ndcY * 0.5f + 0.5f) * gViewport[3];
+	float py = gWindowHeight - pyGL;
+
+	if (nx) *nx = px / (float) (gWindowWidth > 0 ? gWindowWidth : 1);
+	if (ny) *ny = py / (float) (gWindowHeight > 0 ? gWindowHeight : 1);
+	return true;
+}
