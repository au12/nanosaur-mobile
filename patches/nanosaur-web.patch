+void WebGL_EnableClientState(GLenum array)
+{
+	EnsureInit();
+	ClientArray* a = GetClientArray(array);
+	if (a) a->enabled = true;
+}
+
+void WebGL_DisableClientState(GLenum array)
+{
+	EnsureInit();
+	ClientArray* a = GetClientArray(array);
+	if (a) a->enabled = false;
+}
