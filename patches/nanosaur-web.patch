+/****************************/
+/*    LIGHTING / FOG        */
+/****************************/
+
+void WebGL_Lightfv(GLenum light, GLenum pname, const GLfloat* params)
+{
+	EnsureInit();
+	if (light < LGL_LIGHT0 || light >= LGL_LIGHT0 + 8)
+		return;
+
+	Light* l = &S.lights[light - LGL_LIGHT0];
+	switch (pname)
+	{
+		case LGL_POSITION:
+		{
+			// Light positions are transformed by the modelview matrix at the time they're specified
+			const float* m = S.mvStack[S.mvTop].m;
+			float x = params[0], y = params[1], z = params[2], w = params[3];
+			l->eyeDir[0] = m[0]*x + m[4]*y + m[8]*z  + m[12]*w;
+			l->eyeDir[1] = m[1]*x + m[5]*y + m[9]*z  + m[13]*w;
+			l->eyeDir[2] = m[2]*x + m[6]*y + m[10]*z + m[14]*w;
+			l->eyeDir[3] = w;
+			break;
+		}
+		case LGL_AMBIENT:	memcpy(l->ambient, params, sizeof(float)*4); break;
+		case LGL_DIFFUSE:	memcpy(l->diffuse, params, sizeof(float)*4); break;
+		default:			break;
+	}
+	S.lightSerial++;
+}
+
+void WebGL_LightModelfv(GLenum pname, const GLfloat* params)
+{
+	EnsureInit();
+	if (pname == LGL_LIGHT_MODEL_AMBIENT)
+	{
+		memcpy(S.sceneAmbient, params, sizeof(float)*4);
+		S.lightSerial++;
+	}
+}
